# ========================================================
# Home Stock Portfolio Environment Variables Template
# ========================================================

# Web Server Port
PORT=8080

# Basic Auth Credentials (Optional / Auto-encrypted)
# DASHBOARD_USER=your_username
# DASHBOARD_PASSWORD=your_password

# --------------------------------------------------------
# 1. Toss Securities Open API
# --------------------------------------------------------
TOSS_CLIENT_ID=your_toss_client_id
TOSS_CLIENT_SECRET=your_toss_client_secret

# --------------------------------------------------------
# 2. Korea Investment & Securities (KIS) Accounts
# --------------------------------------------------------
# Account 1: Pension Savings (연금저축)
KIS_1_CANO=your_kis_cano_1
KIS_1_PRDT=22
KIS_1_LABEL=한투 연금저축
KIS_1_APP_KEY=your_kis_app_key_1
KIS_1_APP_SECRET=your_kis_app_secret_1

# Account 2: ISA (중개형 ISA)
KIS_2_CANO=your_kis_cano_2
KIS_2_PRDT=01
KIS_2_LABEL=한투 ISA
KIS_2_APP_KEY=your_kis_app_key_2
KIS_2_APP_SECRET=your_kis_app_secret_2

# Account 3: IRP (개인형 퇴직연금)
KIS_3_CANO=your_kis_cano_3
KIS_3_PRDT=29
KIS_3_LABEL=한투 IRP
KIS_3_APP_KEY=your_kis_app_key_3
KIS_3_APP_SECRET=your_kis_app_secret_3

# Account 4: General Stock (일반 위탁)
KIS_4_CANO=your_kis_cano_4
KIS_4_PRDT=01
KIS_4_LABEL=한투 일반위탁
KIS_4_APP_KEY=your_kis_app_key_4
KIS_4_APP_SECRET=your_kis_app_secret_4
